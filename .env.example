DATABASE_URL=postgres://vireon:vireon@localhost:5432/vireon_core
REDIS_URL=redis://localhost:6379
PGVECTOR_DIMENSIONS=1536
TEST_TENANT_ID=
ELORA_WORKSPACE_ROOT=./data/elora-workspace
ELORA_WORKSPACE_MAX_BYTES=1000000

# Phase 6F: dedicated Anthropic key for CORE (server-side only -- never
# read in apps/web, never a VITE_*-prefixed variable). Optional: if unset,
# ELORA falls back to the deterministic template response for every branch.
ANTHROPIC_API_KEY=

# PR 3: OpenAI direct provider (server-side only -- never read in apps/web,
# never a VITE_*-prefixed variable). Only required when MODEL_PROVIDER=openai;
# selecting "anthropic" never touches this.
OPENAI_API_KEY=
# MODEL_PROVIDER selects which LlmProvider src/elora/llm/providerSelection.ts
# constructs: "anthropic" or "openai". Fail-closed -- an unset or
# unrecognized value fails startup validation, never a silent default.
MODEL_PROVIDER=anthropic
# PR 3: providers approved to receive CONFIDENTIAL-classified content
# (src/elora/llm/contentPolicy/). Comma-separated; defaults to both known
# providers if unset. A single global setting -- per-tenant policy is out
# of scope for this PR.
MODEL_POLICY_APPROVED_PROVIDERS=anthropic,openai

# PR 0: OTel OTLP exporter target. Phoenix's HTTP OTLP endpoint lives on its
# main UI port (6006), not the standard 4318 -- see docker-compose.yml's
# `phoenix` service (profile: observability). Backend-neutral: point this at
# any OTLP/HTTP-proto collector, Phoenix is just the default local target.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
OTEL_SERVICE_NAME=vireon-core
# Dev-only opt-in: when true, span attributes may include raw message/prompt
# content. Off by default, everywhere, including local dev.
OTEL_CAPTURE_CONTENT=false
