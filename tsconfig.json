{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "declaration": false,
    "sourceMap": false,
    "noUncheckedIndexedAccess": true,
    "types": ["node"]
  },
  "include": ["src", "tests", "test-utils", "tools"],
  "exclude": ["node_modules", "dist"]
}
