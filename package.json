{
  "name": "vireon-core",
  "version": "0.1.0",
  "private": true,
  "description": "Vireon CORE - state-centric relational operating runtime",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:phase1": "vitest run tests/integration/phase1.database-spine.test.ts",
    "test:phase1:redis": "vitest run tests/integration/phase1.redis-connectivity.test.ts",
    "test:phase2": "vitest run tests/integration/phase2.state-machine-lifecycle.test.ts",
    "test:phase2.5": "vitest run tests/integration/phase2_5.diagnostics-console.test.ts",
    "test:phase3": "vitest run tests/integration/phase3.elora-ingestion.test.ts",
    "test:phase4": "vitest run tests/integration/phase4.receipts-authority.test.ts",
    "test:phase5": "vitest run tests/integration/phase5.tool-registry.test.ts",
    "test:phase6b": "vitest run tests/integration/phase6b.authority-hierarchy.test.ts",
    "test:phase6c": "vitest run tests/integration/phase6c.authority-resolution.test.ts",
    "test:phase6d": "vitest run tests/integration/phase6d.delegation.test.ts",
    "test:phase6e": "vitest run tests/integration/phase6e.ui-contract-layer.test.ts",
    "test:phase6f": "vitest run tests/integration/phase6f.llm-integration.test.ts",
    "test:phase6g": "vitest run tests/integration/phase6g.memory-review.test.ts",
    "test:phase6i": "vitest run tests/integration/phase6i.scheduled-trigger-creation.test.ts",
    "test:phase6j": "vitest run tests/integration/phase6j.trigger-execution-engine.test.ts",
    "test:phase6k": "vitest run tests/integration/phase6k.operator-directive-ledger.test.ts",
    "test:phase6m": "vitest run tests/integration/phase6m.operator-deck.test.ts",
    "test:pr0-observability": "vitest run tests/integration/pr0.observability.test.ts",
    "test:pr1-cognitive-run-contract": "vitest run tests/integration/pr1.cognitive-run-contract.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:worktree": "tsx scripts/setupWorktreeDatabase.ts",
    "setup:dev": "pnpm db:worktree && pnpm db:migrate && pnpm seed:dev-identity",
    "diagnostics": "tsx tools/diagnostics/index.ts",
    "seed:dev-identity": "tsx scripts/seedDevIdentity.ts",
    "seed:persona-roster": "tsx scripts/seedPersonaRoster.ts",
    "dev:server": "tsx watch src/http/server.ts",
    "dev:trigger-poller": "tsx watch scripts/runTriggerPoller.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@vireon/contracts": "workspace:*",
    "@vireon/persona-config": "workspace:*",
    "cron-parser": "^5.6.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
